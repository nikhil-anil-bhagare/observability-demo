# Copy to .env before starting the app:
#   cp .env.example .env
#
# Every value below is also the built-in default, so the app runs with the
# stack from docker-compose.yml even without a .env file.

# HTTP port the service listens on.
PORT=3000

NODE_ENV=development

# Reported as service.name on every trace, metric and log record, and returned
# by GET /.
#
# NOTE: `pnpm start` overrides this with APPLICATION_NAME=checkout-service.
# The queries in the README filter on checkout-service, so start the app with
# `pnpm start` rather than invoking node directly.
APPLICATION_NAME=observability-demo
APPLICATION_VERSION=1.0.0

# OTLP/HTTP endpoint of the OpenTelemetry Collector. Traces, metrics and logs
# are all sent here.
#
# Port 14318, not 4318 — Tempo owns 4318 on the host (see docker-compose.yml).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Uncomment to debug the OpenTelemetry SDK itself (very verbose). Useful when
# spans or log records are not reaching the collector.
# OTEL_LOG_LEVEL=debug
